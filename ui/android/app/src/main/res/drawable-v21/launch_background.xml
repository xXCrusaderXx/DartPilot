<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while the app starts: the app's dark surface with its icon, so no white flash comes before the dark app.
     The icon is the PNG foreground layer: @mipmap/ic_launcher is an adaptive icon from API 26 on, which <bitmap> cannot load. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
